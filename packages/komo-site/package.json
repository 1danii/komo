{
  "name": "komo-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tjcages/komo build && node scripts/build.mjs",
    "dev": "pnpm run build && pnpm preview",
    "preview": "vite preview --host 127.0.0.1 --port 4340 --strictPort",
    "deploy": "pnpm run build && wrangler deploy --config wrangler.jsonc",
    "typecheck": "wrangler types worker/worker-configuration.d.ts && tsc -p tsconfig.json && tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@tjcages/komo": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.1",
    "wrangler": "4.136.3"
  }
}
